{
  "id": "./",
  "name": "Paperly PDF \u2014 private in-browser PDF tools",
  "short_name": "Paperly",
  "description": "51 private PDF tools that run entirely in your browser: merge, compress, OCR, redact, convert, sign and fill forms. Files never leave your device.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f7f4ec",
  "theme_color": "#12211a",
  "categories": [
    "productivity",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Merge PDFs",
      "short_name": "Merge",
      "url": "./merge-pdf/"
    },
    {
      "name": "Compress a PDF",
      "short_name": "Compress",
      "url": "./compress-pdf/"
    },
    {
      "name": "OCR a scanned PDF",
      "short_name": "OCR",
      "url": "./ocr-pdf/"
    }
  ]
}
