# Public production origin used by canonical tags, sitemap.xml, robots.txt and
# Open Graph metadata. No trailing slash.
SITE_URL=https://paperlypdf.com

# Optional: activate Pro without a Lemon Squeezy key during local development.
VITE_PRO_DEV_MODE=false

# Optional Lemon Squeezy endpoints (defaults shown).
VITE_PRO_LICENSE_ENDPOINT=https://api.lemonsqueezy.com/v1/licenses/validate
VITE_PRO_CHECKOUT_URL=https://paperly.lemonsqueezy.com/checkout/buy/YOUR_VARIANT_ID
